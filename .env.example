# ============================================================
# QuantFlow: environment template
#
# Copy to .env and fill in your own values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Every value below
# is a placeholder: replace anything that says "your_".
#
# Defaults shown are the fallbacks in config.py, used when a variable
# is absent from .env.
# ============================================================

# ── Database (Postgres / Supabase) ───────────────────────────────────────────
# Local Postgres: leave DB_HOST as localhost.
# Supabase: use the pooler host from Project Settings > Database.
DB_HOST=localhost

# Postgres port. Supabase's connection pooler also listens on 5432.
DB_PORT=5432

# Database name. `make setup` expects this to exist already; create it
# first with: psql -U postgres -c "CREATE DATABASE stock_pipeline;"
DB_NAME=stock_pipeline

# Postgres role. Supabase's pooler takes postgres.<project-ref>, where
# <project-ref> is your project's 20-letter id (in its connection string),
# not a word to keep: the pooler refuses the login without it.
DB_USER=postgres

# Postgres password. No default: the pipeline cannot connect without it.
DB_PASSWORD=your_postgres_password_here

# TLS mode for the database connection. Default: require
#
#   require      Encrypts the connection, but does NOT check the server's
#                certificate. This is the default because it removes libpq's
#                worst behaviour: 'prefer' (libpq's own default) silently falls
#                back to CLEARTEXT if the peer declines TLS: no error, no log.
#   verify-full  Also verifies the certificate chain and hostname. Recommended,
#                but needs DB_SSLROOTCERT (see below) because Supabase signs its
#                pooler certificate with a private CA that is in neither the
#                system trust store nor certifi.
#   disable      Never do this against a hosted database.
DB_SSLMODE=require

# The read-only role (sql/schema_roles.sql), on the same host and database.
# Reads of the live database outside the pipeline (the diagnostics and the
# evaluation's snapshot export, with --live) log in as it and refuse to run
# without it. Supabase's pooler: quantflow_readonly.<project-ref>, the same
# <project-ref> as DB_USER's.
DB_READONLY_USER=
DB_READONLY_PASSWORD=

# Path to a CA certificate bundle, required only for verify-ca / verify-full.
# Supabase: Project Settings > Database > SSL Configuration > download the
# certificate, save it, and point this at the file. Leave blank for 'require'.
# DB_SSLROOTCERT=C:/path/to/prod-ca-2021.crt
DB_SSLROOTCERT=

# ── API keys ─────────────────────────────────────────────────────────────────
# Free key from https://www.alphavantage.co/support/#api-key
# Only needed for ingestion/alpha_vantage_fetcher.py; the yFinance path
# needs no key, so you can leave this blank to start.
ALPHA_VANTAGE_API_KEY=

# Leave blank. Since 2026-11-09 the features count Yahoo Finance RSS articles
# only (docs/evaluation.md, section 4): NewsAPI's free plan is for development
# and testing only. With a key, sentiment.py still fetches NewsAPI and stores
# its articles, which never count; blank skips the fetch with a warning.
NEWS_API_KEY=

# ── Tickers ──────────────────────────────────────────────────────────────────
# Comma-separated. Whitespace is stripped and symbols are upcased, so
# " aapl , msft " is read as ["AAPL", "MSFT"].
# The 8 below are what the README and the daily CI workflow track.
# config.py falls back to the same 8 if this is unset.
TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,META,JPM

# ── Scheduler ────────────────────────────────────────────────────────────────
# Minutes between price-ingestion runs in the laptop scheduler
# (python -m quantflow.pipelines.scheduler).
# Ignored by the one-shot CLI entry points. Default: 15
FETCH_INTERVAL_MINUTES=15

# ── Split guard ──────────────────────────────────────────────────────────────
# The daily refresh fails if stored daily closes differ from Yahoo's raw
# closes by more than this fraction on three or more consecutive dates, which
# is what a stock split after the rows were stored looks like. A fraction, not
# a percentage: 0.15 means 15%. Must be between 0 and 1. Default: 0.15
# It also fails on a split-sized one-day move (a close at or below 0.733x or
# at or above 1.35x the one before). Real moves of that size are listed in
# config/split_jump_acknowledged.txt, a committed file, not here.
SPLIT_GUARD_THRESHOLD=0.15

# ── Trending tier (docs/trending.md, section 11) ─────────────────────────────
# Discovery and analytics only: no forecast, ensemble or backtest. Each value
# is read when the tier runs, not at import, so a typo stops that run alone.
# A blank value takes the default shown. A local run (make trending) writes
# as DB_USER above; trending.yml logs in as its own role, quantflow_trending,
# from the repository's TRENDING_DB_USER and TRENDING_DB_PASSWORD secrets
# (sql/schema_roles.sql, steps 11 to 14), which nothing here needs.

# Always tracked, even on days no list carries them, outside the cap.
# Comma-separated; at most 10 are read. Default: SPCX
TRENDING_PINNED=SPCX

# The lists to read, in priority order for equal ranks. Known lists:
# trending_tickers, most_actives, day_gainers, day_losers (the default, all four).
TRENDING_LISTS=

# Discovered symbols tracked at once. Default: 15
TRENDING_MAX_ACTIVE=

# Symbols with no stored history that may join in one run (each costs a 6-month
# history download). Default: 5
TRENDING_MAX_NEW_PER_RUN=

# Counted sessions a symbol may be absent from every list before it is
# deactivated, when the cap leaves it room. Default: 5
TRENDING_INACTIVE_AFTER_DAYS=

# Price floor in dollars; 0 turns it off. Default: 5
TRENDING_MIN_PRICE=

# Optional market-cap floor in dollars. Default: blank, off.
TRENDING_MIN_MARKET_CAP=

# Promotion eligibility (shown on the dashboard; promotion itself is manual):
# distinct sessions on the lists (default: 20), and trading days of history
# (default: 504, two years).
TRENDING_PROMOTION_MIN_DAYS=
PROMOTION_MIN_HISTORY_DAYS=

# ── Logging ──────────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR. Default: INFO
# Logs go to the console and to pipeline.log in LOG_DIR (rotating, 5MB x 3).
LOG_LEVEL=INFO

# Where log files go. Default: logs/ in the working directory.
LOG_DIR=
